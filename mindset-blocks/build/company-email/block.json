{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mindset-blocks/company-email",
  "version": "1.0.0",
  "title": "Company Email",
  "category": "text",
  "icon": "email",
  "description": "Output the company email with an optional icon.",
  "example": {},
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
